# Environment variables template.
# Copy this file to ".env" and fill in real values.
# .env is gitignored — never commit real credentials.

# ============================================================
# Salesforce OAuth 2.0 — Web Server Flow (Week 4)
# ============================================================

# From your Connected App in Salesforce: App Manager → your app → Manage Consumer Details
SALESFORCE_CLIENT_ID=your_consumer_key_here
SALESFORCE_CLIENT_SECRET=your_consumer_secret_here

# Salesforce login URL — login.salesforce.com for prod/dev, test.salesforce.com for sandbox
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# OAuth redirect URI — must match the Callback URL configured in the Connected App
SALESFORCE_REDIRECT_URI=http://localhost:8000/auth/callback

# ============================================================
# App settings
# ============================================================

# When "true", lifespan uses MockSalesforceClient instead of real SalesforceClient
USE_MOCK_DATA=true

APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================================
# Anthropic API (added Week 5)
# ============================================================

# ANTHROPIC_API_KEY=sk-ant-...
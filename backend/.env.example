# Environment variables template.
# Copy this file to ".env" and fill in real values.
# .env is gitignored — never commit real credentials.

# ============================================================
# Salesforce credentials (needed in Week 4)
# ============================================================

SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=your_connected_app_client_id_here
SALESFORCE_CLIENT_SECRET=your_connected_app_client_secret_here
SALESFORCE_USERNAME=your_username@example.com
SALESFORCE_PASSWORD=your_password_plus_security_token

# ============================================================
# Anthropic API (added Week 5)
# ============================================================

# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# App settings
# ============================================================

# Set to "true" during Week 3 to use mock data instead of live Salesforce
USE_MOCK_DATA=true

# FastAPI settings
APP_HOST=0.0.0.0
APP_PORT=8000
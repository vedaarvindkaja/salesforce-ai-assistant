{
  "name": "salesforce-graph",
  "displayName": "Salesforce Graph",
  "description": "In-editor access to the Salesforce AI metadata-graph intelligence platform.",
  "version": "0.0.1",
  "publisher": "veda-dev",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "salesforceGraph.ask", "title": "Salesforce Graph: Ask" },
      { "command": "salesforceGraph.explainApex", "title": "Salesforce Graph: Explain Current Apex File" },
      { "command": "salesforceGraph.deploymentImpact", "title": "Salesforce Graph: Deployment Impact of Current File" },
      { "command": "salesforceGraph.generateSoql", "title": "Salesforce Graph: Generate SOQL" },
      { "command": "salesforceGraph.analyzeDebugLog", "title": "Salesforce Graph: Analyze Debug Log File" },
      { "command": "salesforceGraph.checkConnection", "title": "Salesforce Graph: Check API Connection" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "salesforceGraph.explainApex", "when": "resourceExtname == '.cls' || resourceExtname == '.trigger'" },
        { "command": "salesforceGraph.deploymentImpact", "when": "resourceExtname == '.cls' || resourceExtname == '.trigger'" },
        { "command": "salesforceGraph.analyzeDebugLog", "when": "resourceExtname == '.log'" }
      ],
      "editor/context": [
        {
          "command": "salesforceGraph.explainApex",
          "when": "resourceExtname == '.cls' || resourceExtname == '.trigger'",
          "group": "salesforceGraph@1"
        },
        {
          "command": "salesforceGraph.deploymentImpact",
          "when": "resourceExtname == '.cls' || resourceExtname == '.trigger'",
          "group": "salesforceGraph@2"
        },
        {
          "command": "salesforceGraph.analyzeDebugLog",
          "when": "resourceExtname == '.log'",
          "group": "salesforceGraph@1"
        }
      ]
    },
    "configuration": {
      "title": "Salesforce Graph",
      "properties": {
        "salesforceGraph.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the local Salesforce Graph REST API (uvicorn). Use 127.0.0.1 rather than localhost to avoid IPv6 resolution delays on Windows."
        },
        "salesforceGraph.renderer": {
          "type": "string",
          "enum": ["webview", "output"],
          "default": "webview",
          "enumDescriptions": [
            "Render answers as formatted Markdown in a webview panel.",
            "Render answers as raw text in an Output channel."
          ],
          "description": "Where to render streamed answers. Both consume the same SSE stream via one Renderer interface."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "marked": "^12.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

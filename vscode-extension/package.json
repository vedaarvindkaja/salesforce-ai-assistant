{
  "name": "salesforce-graph",
  "displayName": "Salesforce Graph",
  "description": "In-editor access to the Salesforce AI metadata-graph intelligence platform.",
  "version": "0.0.1",
  "publisher": "veda-dev",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "salesforceGraph.ask",
        "title": "Salesforce Graph: Ask"
      },
      {
        "command": "salesforceGraph.checkConnection",
        "title": "Salesforce Graph: Check API Connection"
      }
    ],
    "configuration": {
      "title": "Salesforce Graph",
      "properties": {
        "salesforceGraph.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the local Salesforce Graph REST API (uvicorn). Use 127.0.0.1 rather than localhost to avoid IPv6 resolution delays on Windows."
        },
        "salesforceGraph.renderer": {
          "type": "string",
          "enum": ["webview", "output"],
          "default": "webview",
          "enumDescriptions": [
            "Render answers as formatted Markdown in a webview panel.",
            "Render answers as raw text in an Output channel."
          ],
          "description": "Where to render streamed answers. Both consume the same SSE stream via one Renderer interface."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "marked": "^12.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
